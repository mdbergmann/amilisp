# CL-Amiga Makefile for MorphOS (PPC) — native build
#
# Builds clamiga *under* MorphOS *for* MorphOS using the MorphOS SDK GCC.
# Run from a MorphOS shell (or a MorphOS GCC environment):
#
#     make -f Makefile.mos              # build build/morphos/clamiga
#     make -f Makefile.mos clean
#
# Notes / design:
#   * Bytecode VM only.  The native-code JIT is m68k-only (codegen_m68k.c,
#     asm_m68k.c, ffi_dispatch_m68k.s, gated by -DJIT_M68K); PPC cannot run
#     m68k machine code, so we build the portable VM exactly like the host
#     build (only jit/codebuf.c is compiled, JIT_M68K is NOT defined).
#   * Platform layer is the AmigaOS one (platform_amiga.c +
#     platform_thread_amiga.c) compiled with -DPLATFORM_AMIGA, because
#     MorphOS provides the AmigaOS API (proto/exec, proto/dos,
#     SignalSemaphore, CreateNewProc, FindTask tc_UserData, ...).
#   * -DPLATFORM_MORPHOS is an extra marker on top of -DPLATFORM_AMIGA so
#     MorphOS-specific divergences can be #ifdef'd: the PPC library-call
#     dispatcher for platform_amiga_call() (EmulCallDirectOS through the
#     ABox per-task register frame — the AMIGA FFI/GUI/audio stack works
#     on MorphOS), the PPC-stack platform_stack_headroom() (ETask
#     PPCSPLower, not the 68k tc_SPLower), and the NP_Entry trap gates in
#     platform_amiga_ppc.h.
#   * PPC is big-endian and 32-bit like m68k, so the FASL wire format and
#     all 32-bit heap-struct assumptions hold unchanged.
#   * CL_WIDE_STRINGS IS defined (matches the host build, not the m68k
#     Amiga builds): MorphOS machines have the RAM for full Unicode, and
#     libraries like flexi-streams/drakma hard-require CHAR-CODE-LIMIT
#     >= 65533.  The representation is adaptive — 8-bit TYPE_STRING stays
#     the default, TYPE_WIDE_STRING (UTF-32) is used only for strings that
#     actually contain chars > 255.  FASL compatibility with the m68k
#     builds: the writer downgrades all-ASCII strings to the narrow tag,
#     so MorphOS reads every m68k FASL, and m68k reads MorphOS FASLs
#     unless they contain non-ASCII string literals (those use
#     FASL_TAG_WIDE_STRING, which byte-only builds reject cleanly).

# MorphOS SDK GCC.  Override on the command line if your toolchain uses a
# different name, e.g.  make -f Makefile.mos CC=ppc-morphos-gcc
CC      = gcc

# PPC has none of the m68k -O2 miscompiles documented in Makefile.cross,
# so -O2 is safe here.
CFLAGS  ?= -std=c99 -noixemul -Wall -O2 -DPLATFORM_AMIGA -DPLATFORM_MORPHOS -DCL_WIDE_STRINGS $(DEBUG_FLAGS)
# -noixemul is a LINK-time flag as well: it selects the libnix startup code
# and libc.  Without it here the link silently falls back to the ixemul
# startup/libc even though every object was compiled -noixemul — the binary
# then runs on ixemul.library's Unix-emulation layer, whose internal state
# has been observed to park the main task in a permanent exec/Wait() (empty
# tc_SigWait) deep into long runs.  Keep compile and link flags in agreement.
LDFLAGS ?= -noixemul

# AmiSSL SDK headers (vendored in include/amissl-sdk — see its README.md):
# MorphOS uses the very same SDK; <proto/amissl.h> selects the ppcinline
# headers under __PPC__, which call the 68k amissl libraries through the
# ABox emulation.  The resulting TLS support is COMPILE-UNTESTED on MorphOS
# so far — build natively and run tests/amiga/tls-tests.lisp to verify.
# The long-term plan is MorphOS's native openssl3.library instead; the
# reactor TLS code is provider-agnostic OpenSSL 3.x API either way.
# Deleting the headers (wildcard guard) restores the previous TLS-less build.
AMISSL_INC ?= include/amissl-sdk
ifneq ($(wildcard $(AMISSL_INC)/proto/amissl.h),)
CFLAGS += -DCL_HAVE_AMISSL -I$(AMISSL_INC)
endif
LDLIBS  ?= -lm

SRCDIR   = src
BUILDDIR = build/morphos

# --- Source files -----------------------------------------------------------
# Mirrors the modern source list in Makefile.cross, minus the m68k JIT
# codegen/asm and the m68k FFI trampoline.

PLATFORM_SRC = $(SRCDIR)/platform/platform_amiga.c \
               $(SRCDIR)/platform/platform_amiga_rexx.c \
               $(SRCDIR)/platform/platform_thread_amiga.c

CORE_SRC     = $(SRCDIR)/core/types.c \
               $(SRCDIR)/core/mem.c \
               $(SRCDIR)/core/gc_trace.c \
               $(SRCDIR)/core/gc_classic.c \
               $(SRCDIR)/core/gc_compact.c \
               $(SRCDIR)/core/gc_jitscan.c \
               $(SRCDIR)/core/gc_verify.c \
               $(SRCDIR)/core/error.c \
               $(SRCDIR)/core/symbol.c \
               $(SRCDIR)/core/package.c \
               $(SRCDIR)/core/reader.c \
               $(SRCDIR)/core/readtable.c \
               $(SRCDIR)/core/printer.c \
               $(SRCDIR)/core/env.c \
               $(SRCDIR)/core/compiler.c \
               $(SRCDIR)/core/compiler_special.c \
               $(SRCDIR)/core/compiler_extra.c \
               $(SRCDIR)/core/peephole.c \
               $(SRCDIR)/core/vm.c \
               $(SRCDIR)/core/builtins.c \
               $(SRCDIR)/core/builtins_arith.c \
               $(SRCDIR)/core/builtins_io.c \
               $(SRCDIR)/core/builtins_format.c \
               $(SRCDIR)/core/builtins_mutation.c \
               $(SRCDIR)/core/builtins_strings.c \
               $(SRCDIR)/core/builtins_lists.c \
               $(SRCDIR)/core/builtins_hashtable.c \
               $(SRCDIR)/core/builtins_sequence.c \
               $(SRCDIR)/core/builtins_sequence2.c \
               $(SRCDIR)/core/builtins_type.c \
               $(SRCDIR)/core/builtins_condition.c \
               $(SRCDIR)/core/builtins_package.c \
               $(SRCDIR)/core/builtins_struct.c \
               $(SRCDIR)/core/builtins_array.c \
               $(SRCDIR)/core/builtins_stream.c \
               $(SRCDIR)/core/builtins_random.c \
               $(SRCDIR)/core/builtins_bitvector.c \
               $(SRCDIR)/core/builtins_pathname.c \
               $(SRCDIR)/core/builtins_describe.c \
               $(SRCDIR)/core/builtins_inspect.c \
               $(SRCDIR)/core/builtins_thread.c \
               $(SRCDIR)/core/builtins_ffi.c \
               $(SRCDIR)/core/builtins_amiga.c \
               $(SRCDIR)/core/bindtab.c \
               $(SRCDIR)/core/stream.c \
               $(SRCDIR)/core/bignum.c \
               $(SRCDIR)/core/ratio.c \
               $(SRCDIR)/core/float.c \
               $(SRCDIR)/core/float_dtoa.c \
               $(SRCDIR)/core/float_math.c \
               $(SRCDIR)/core/debugger.c \
               $(SRCDIR)/core/repl.c \
               $(SRCDIR)/core/fasl.c \
               $(SRCDIR)/core/image.c \
               $(SRCDIR)/core/cmdline.c \
               $(SRCDIR)/core/color.c \
               $(SRCDIR)/core/thread.c \
               $(SRCDIR)/core/string_utils.c

# Portable JIT pieces only (code-buffer mechanics).  The m68k codegen
# (jit_m68k.c, codegen_m68k.c, asm_m68k.c, runtime*.c) is deliberately excluded.
JIT_SRC      = $(SRCDIR)/jit/codebuf.c

MAIN_SRC     = $(SRCDIR)/main.c

ALL_SRCS = $(MAIN_SRC) $(PLATFORM_SRC) $(CORE_SRC) $(JIT_SRC)
ALL_OBJS = $(patsubst $(SRCDIR)/%.c,$(BUILDDIR)/%.o,$(ALL_SRCS))

# NOTE: there is deliberately no native C-unit-test target here.  The C tier
# runs on the host (`make test`, with ASan/gc-stress/generational-GC builds);
# the target-platform gate for MorphOS is the Lisp suite
# (tests/amiga/run-tests.lisp), exactly as FS-UAE is for m68k AmigaOS —
# neither target runs the C tier.  The one MorphOS-critical C check
# (CL_JMPBUF_GUARD sizing) is enforced at every clamiga boot by
# cl_setjmp_overrun_check().

.PHONY: morphos image editor-image clean

morphos: $(BUILDDIR)/clamiga

# Bare-boot heap image beside the binary (build/morphos/clamiga.img) — the
# MorphOS counterpart of Makefile.cross's image-amiga, run natively since
# images are per-build (specs/image-save-load.md).  Save from the binary's
# own directory (where startup looks for an image), then restart from the
# repo root and require the restore to verify — the second run exits 1
# without BOOT-IMAGE-VERIFIED.  The release script packages the result as
# MOS_IMG=... next to MOS_BIN=... .
#
# The save script is copied beside the binary first: make runs under the
# GG shell, whose `..` is meaningless to the -noixemul clamiga it launches
# (AmigaDOS spells the parent directory as a leading `/`), so a
# `../../scripts/...` argument fails with "Cannot open file" on the box.
image: $(BUILDDIR)/clamiga
	rm -f $(BUILDDIR)/clamiga.img
	cp scripts/save-boot-image.lisp $(BUILDDIR)/save-boot-image.lisp
	cd $(BUILDDIR) && ./clamiga --no-userinit --no-image --non-interactive --boot-log --load save-boot-image.lisp
	rm -f $(BUILDDIR)/save-boot-image.lisp
	$(BUILDDIR)/clamiga --no-userinit --non-interactive --boot-log --load scripts/verify-boot-image.lisp

# The Clamacs editor's heap image beside the binary (build/morphos/clamacs.img),
# the MorphOS counterpart of Makefile.cross's editor-image-amiga: the editor
# (clamacs/lisp/, a submodule checkout) is loaded from source and dumped,
# then the image is started from the repo root and must open a window and
# quit (clamacs/scripts/verify-editor-image.lisp; needs MUI, i.e. a
# session on the box's screen).  The release script packages the result as
# CLAMACS_MOS_IMG=... .  The save runs from beside the binary, so the editor
# is named by an ABSOLUTE AmigaDOS path (`../..` means nothing to the
# -noixemul clamiga; `//clamacs/...` works too, but an absolute path keeps
# the FASL source names independent of where the save ran).  The GG shell
# spells the checkout /Work/DevelAdd/...; AMIGA_CURDIR is Work:DevelAdd/...
# (the same absolute paths verify/realamiga/make-editor-image.sh passes).
AMIGA_CURDIR := $(shell echo "$(CURDIR)" | sed 's|^/\([^/]*\)/*|\1:|')

editor-image: $(BUILDDIR)/clamiga
	rm -f $(BUILDDIR)/clamacs.img
	cd $(BUILDDIR) && ./clamiga --no-userinit --no-image --heap 8M --non-interactive --boot-log --load $(AMIGA_CURDIR)/clamacs/lisp/load.lisp --load $(AMIGA_CURDIR)/clamacs/scripts/save-editor-image.lisp
	$(BUILDDIR)/clamiga --no-userinit --heap 8M --non-interactive --boot-log --image $(BUILDDIR)/clamacs.img --load clamacs/scripts/verify-editor-image.lisp

$(BUILDDIR)/clamiga: $(ALL_OBJS)
	@mkdir -p $(dir $@)
	$(CC) $(LDFLAGS) -o $@ $^ $(LDLIBS)

$(BUILDDIR)/%.o: $(SRCDIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -I$(SRCDIR) -MMD -MP -c -o $@ $<

# Auto-generated header dependency files (-MMD -MP): keep objects in sync
# with header (struct ABI) changes — same mechanism as the host/cross
# Makefiles.
-include $(ALL_OBJS:.o=.d)

clean:
	rm -rf $(BUILDDIR)
