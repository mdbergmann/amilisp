# CL-Amiga Cross-compilation Makefile
# Uses m68k-amigaos-gcc from tools/m68k-amigaos-gcc/prefix
# Run: make -f Makefile.cross [amiga|test-amiga|image-amiga|clean]
#      make -f Makefile.cross amiga FPU=1   (hard-float variant, see below)
#      make -f Makefile.cross amiga WIDE=1  (wide-string variant, see below)
#      make -f Makefile.cross image-amiga   (bare-boot clamiga.img beside the
#                                            binary, saved + verified in FS-UAE)

TOOLCHAIN = $(CURDIR)/tools/m68k-amigaos-gcc/prefix
CC        = $(TOOLCHAIN)/bin/m68k-amigaos-gcc
# NOTE: m68k-amigaos-gcc -O2 miscompiles flexible-array pointer access
# (`obj->data` passed as a function argument silently drops the first byte).
# We work around it with `volatile` locals at the affected call sites
# (search for "m68k workaround").  -flto and -O1 each have their own
# regressions on this toolchain — neither is a clean substitute.
#
# -Os passes the full tests/amiga/run-tests.lisp suite on real Amiga
# and produces a ~175 KB smaller binary than -O2, so we use it.
# The volatile workaround above still applies.
# NOTE: -ffunction-sections + -Wl,--gc-sections was tried (2026-05-21) and is a
# NET LOSS on the AmigaOS hunk format: the linker does remove dead sections, but
# per-function alignment padding + per-section hunk-table overhead (hundreds of
# tiny sections) outweighs it — binary grew +35 KB / +6 %. See specs/modularize.md.
# FPU=1 builds the hard-float variant: -m68881 compiles double arithmetic to
# inline FPU instructions (libm from the toolchain's libm020/libm881 multilib)
# instead of soft-float calls through mathieeedoubbas.library.  Runs on any
# machine with an FPU — 68881/68882 cards, 68040/68060 (the 68040/68060.library
# math emulation covers the transcendental instructions), Vampire/PiStorm.
# The binary REQUIRES an FPU: on a plain 68020/68030 it dies with a line-F
# exception, so never point test-amiga-lowend (FPU-less 68020 config) at it.
# Each variant gets its own object dir so the two never mix.
FPU ?= 0
ifeq ($(FPU),1)
FLOATFLAGS = -m68881
BUILDDIR   = build/cross-fpu
else
FLOATFLAGS = -msoft-float
BUILDDIR   = build/cross
endif

# WIDE=1 builds the wide-string variant: CL_WIDE_STRINGS raises
# CHAR-CODE-LIMIT above 65533 (full Unicode in the Lisp heap; the
# representation stays adaptive — 8-bit TYPE_STRING remains the default and
# UTF-32 TYPE_WIDE_STRING is used only for strings actually containing
# chars > 255, so pure-ASCII workloads cost the same as the narrow build).
# The OS never sees wide chars — everything crossing the OS boundary is
# encoded to bytes — but libraries like flexi-streams/drakma hard-require
# the raised CHAR-CODE-LIMIT (their external-format tables call
# (code-char >255) at load time), so this is the knob for running them on
# big-RAM 68k machines (Vampire/PiStorm).  Default is narrow (8-bit): the
# release binaries stay narrow to keep the 68020/8MB primary target lean.
# Composes with FPU=1 (verified on a Vampire V4, 2026-08-15: WIDE=1 FPU=1
# runs drakma with HTTP and AmiSSL HTTPS green); every FPU/WIDE combination
# gets its own object dir so variants never mix.  FASL note: wide-build
# FASLs stay readable by narrow builds unless a literal actually contains
# non-ASCII text (the writer downgrades all-ASCII strings to the narrow
# tag; genuinely wide literals use FASL_TAG_WIDE_STRING, which narrow
# builds reject cleanly).
WIDE ?= 0
ifeq ($(WIDE),1)
WIDEFLAGS = -DCL_WIDE_STRINGS
BUILDDIR := $(BUILDDIR)-wide
else
WIDEFLAGS =
endif

# -fomit-frame-pointer: this gcc keeps a5 frames even at -Os (~2000 link/unlk
# pairs); dropping them saved 8.4 KB of code in the 0.8 binary and frees a5 as
# a general register.  Functions using __builtin_frame_address(0)
# (CL_CAPTURE_SP) still get a real frame.  Measured 2026-09-01, both variants
# suite-verified in FS-UAE 2026-09-02.
CFLAGS    = -noixemul -mcpu=68020 $(FLOATFLAGS) $(WIDEFLAGS) -std=c99 -Wall -Os -fomit-frame-pointer -fno-tree-switch-conversion -DPLATFORM_AMIGA -DJIT_M68K $(DEBUG_FLAGS)

# STRIP=1 (default) links with -s, dropping the HUNK_SYMBOL blocks — ~40 KB
# of the 0.8 binary that nothing at runtime reads.  STRIP=0 keeps them so
# MuForce / SegTracker hit reports and m68k-amigaos-gdb show function names.
STRIP ?= 1
ifeq ($(STRIP),1)
STRIPFLAGS = -s
else
STRIPFLAGS =
endif
LDFLAGS   = -noixemul -mcpu=68020 $(FLOATFLAGS) -fno-tree-switch-conversion $(STRIPFLAGS)

# AmiSSL SDK headers (vendored in include/amissl-sdk — see its README.md):
# give the build TLS (EXT:SOCKET-START-TLS) through amisslmaster.library,
# opened lazily at runtime by the socket reactor.  The gcc path calls
# AmiSSL through the SDK's inline headers (register-mapped calls via
# AmiSSLBase), so no link library is needed; a machine without AmiSSL
# installed still runs — TLS just reports unavailable.  The wildcard guard
# keeps the build working even with the headers removed.
AMISSL_INC ?= $(CURDIR)/include/amissl-sdk
ifneq ($(wildcard $(AMISSL_INC)/proto/amissl.h),)
CFLAGS += -DCL_HAVE_AMISSL -I$(AMISSL_INC)
endif

SRCDIR   = src

# Source files
PLATFORM_SRC = $(SRCDIR)/platform/platform_amiga.c \
               $(SRCDIR)/platform/platform_amiga_rexx.c \
               $(SRCDIR)/platform/platform_thread_amiga.c
PLATFORM_ASM = $(SRCDIR)/platform/ffi_dispatch_m68k.s \
               $(SRCDIR)/platform/stack_swap_m68k.s \
               $(SRCDIR)/platform/cpu_store_probe_m68k.s
CORE_SRC     = $(SRCDIR)/core/types.c \
               $(SRCDIR)/core/mem.c \
               $(SRCDIR)/core/gc_trace.c \
               $(SRCDIR)/core/gc_classic.c \
               $(SRCDIR)/core/gc_compact.c \
               $(SRCDIR)/core/gc_jitscan.c \
               $(SRCDIR)/core/gc_verify.c \
               $(SRCDIR)/core/mem_track.c \
               $(SRCDIR)/core/error.c \
               $(SRCDIR)/core/symbol.c \
               $(SRCDIR)/core/package.c \
               $(SRCDIR)/core/reader.c \
               $(SRCDIR)/core/readtable.c \
               $(SRCDIR)/core/printer.c \
               $(SRCDIR)/core/env.c \
               $(SRCDIR)/core/compiler.c \
               $(SRCDIR)/core/compiler_special.c \
               $(SRCDIR)/core/compiler_extra.c \
               $(SRCDIR)/core/peephole.c \
               $(SRCDIR)/core/vm.c \
               $(SRCDIR)/core/builtins.c \
               $(SRCDIR)/core/builtins_arith.c \
               $(SRCDIR)/core/builtins_io.c \
               $(SRCDIR)/core/builtins_format.c \
               $(SRCDIR)/core/builtins_mutation.c \
               $(SRCDIR)/core/builtins_strings.c \
               $(SRCDIR)/core/builtins_lists.c \
               $(SRCDIR)/core/builtins_hashtable.c \
               $(SRCDIR)/core/builtins_sequence.c \
               $(SRCDIR)/core/builtins_sequence2.c \
               $(SRCDIR)/core/builtins_type.c \
               $(SRCDIR)/core/builtins_condition.c \
               $(SRCDIR)/core/builtins_package.c \
               $(SRCDIR)/core/builtins_struct.c \
               $(SRCDIR)/core/builtins_array.c \
               $(SRCDIR)/core/builtins_stream.c \
               $(SRCDIR)/core/builtins_random.c \
               $(SRCDIR)/core/builtins_bitvector.c \
               $(SRCDIR)/core/builtins_pathname.c \
               $(SRCDIR)/core/builtins_describe.c \
               $(SRCDIR)/core/builtins_inspect.c \
               $(SRCDIR)/core/builtins_thread.c \
               $(SRCDIR)/core/builtins_ffi.c \
               $(SRCDIR)/core/builtins_amiga.c \
               $(SRCDIR)/core/bindtab.c \
               $(SRCDIR)/core/stream.c \
               $(SRCDIR)/core/bignum.c \
               $(SRCDIR)/core/ratio.c \
               $(SRCDIR)/core/float.c \
               $(SRCDIR)/core/float_dtoa.c \
               $(SRCDIR)/core/float_math.c \
               $(SRCDIR)/core/debugger.c \
               $(SRCDIR)/core/repl.c \
               $(SRCDIR)/core/fasl.c \
               $(SRCDIR)/core/image.c \
               $(SRCDIR)/core/cmdline.c \
               $(SRCDIR)/core/color.c \
               $(SRCDIR)/core/thread.c \
               $(SRCDIR)/core/string_utils.c
JIT_SRC      = $(SRCDIR)/jit/codebuf.c \
               $(SRCDIR)/jit/jit_common.c \
               $(SRCDIR)/jit/jit_m68k.c \
               $(SRCDIR)/jit/codegen_m68k.c \
               $(SRCDIR)/jit/asm_m68k.c \
               $(SRCDIR)/jit/runtime.c \
               $(SRCDIR)/jit/runtime_nlx.c \
               $(SRCDIR)/jit/runtime_m68k.c
JIT_ASM      = $(SRCDIR)/jit/jit_enter_m68k.s
MAIN_SRC     = $(SRCDIR)/main.c

ALL_SRCS = $(MAIN_SRC) $(PLATFORM_SRC) $(CORE_SRC) $(JIT_SRC)
ALL_OBJS = $(patsubst $(SRCDIR)/%.c,$(BUILDDIR)/%.o,$(ALL_SRCS)) \
           $(patsubst $(SRCDIR)/%.s,$(BUILDDIR)/%.o,$(PLATFORM_ASM) $(JIT_ASM))

.PHONY: amiga test-amiga test-amiga-lowend examples-amiga image-amiga editor-image-amiga clean check-toolchain probes

amiga: check-toolchain $(BUILDDIR)/clamiga $(BUILDDIR)/wbrun

# probes: the standalone CPU/system probes of verify/realamiga (PROBES.md) --
# storeprobe (the Vampire 68080 lost-store defect), fpuregtest, regtest,
# stackprobe.  Plain -O1 68020 binaries, no runtime needed on the Amiga.
PROBE_NAMES = storeprobe fpuregtest regtest stackprobe
probes: check-toolchain $(patsubst %,$(BUILDDIR)/probes/%,$(PROBE_NAMES))
	@echo "probes built: $(patsubst %,$(BUILDDIR)/probes/%,$(PROBE_NAMES))"

$(BUILDDIR)/probes/%: verify/realamiga/%.c
	@mkdir -p $(dir $@)
	$(CC) -noixemul -mcpu=68020 -O1 -Wall -Wno-unused-variable -o $@ $<

# wbrun: starts a program the way Workbench does (verify/realamiga/wbrun.c);
# the suite's Workbench-start leg runs clamiga through it.
$(BUILDDIR)/wbrun: verify/realamiga/wbrun.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $<

check-toolchain:
	@if [ ! -x "$(CC)" ]; then \
		echo ""; \
		echo "  m68k-amigaos-gcc not found at:"; \
		echo "    $(CC)"; \
		echo ""; \
		echo "  Install it with:"; \
		echo "    ./tools/setup-toolchain.sh"; \
		echo ""; \
		echo "  (downloads a prebuilt toolchain on macOS arm64,"; \
		echo "   builds from source elsewhere — pass --build to force)"; \
		echo ""; \
		exit 1; \
	fi

$(BUILDDIR)/clamiga: $(ALL_OBJS)
	@mkdir -p $(dir $@)
	$(CC) $(LDFLAGS) -o $@ $^ -lm
	@# A heap image belongs to the binary that wrote it: the fingerprint
	@# only covers version/format, so a relink of the same version would
	@# still accept an image holding the PREVIOUS build's boot.lisp.  Drop
	@# it; image-amiga writes a fresh one.
	@rm -f $(BUILDDIR)/clamiga.img

$(BUILDDIR)/%.o: $(SRCDIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -I$(SRCDIR) -MMD -MP -c -o $@ $<

$(BUILDDIR)/%.o: $(SRCDIR)/%.s
	@mkdir -p $(dir $@)
	$(CC) -mcpu=68020 -c -o $@ $<

# Auto-generated header dependency files (-MMD -MP).  Without this,
# changing a header (e.g. CL_Thread or CL_ErrorFrame layout in
# error.h / thread.h) leaves dependent .o files stale and produces
# silently mismatched ABIs — a regression mode that previously cost
# real debug time on this codebase.  Mirrors what the host Makefile
# does via the same mechanism.
-include $(ALL_OBJS:.o=.d)

# Cross-compile, place binary, launch FS-UAE for testing.
# Default: high-end JIT config (A4000/68040/Picasso96) — faster turnaround
# for everyday verification.  Use `test-amiga-lowend` to run against the
# documented 68020 baseline (A1200/68020/16 MB, cycle-accurate, no JIT).
#
# run-fs-uae.sh supervises the emulator so the run is fully unattended:
# `C:UAEquit` (appended to call-on-ustartup) quits FS-UAE when the suite
# finishes, and the script's watchdog kills it if clamiga hangs.  No manual
# window-closing required.
# Only the FS-UAE targets (and run-examples.sh) copy into build/amiga/ — the
# link rule deliberately does not, so an experimental `make amiga BUILDDIR=...`
# never replaces the binary FS-UAE runs.  The cp lives here, not in the link
# rule, also because of FPU= variant switching: an up-to-date $(BUILDDIR)/clamiga
# skips the link rule, and FS-UAE would silently test whichever variant was
# deployed last.
test-amiga: $(BUILDDIR)/clamiga $(BUILDDIR)/wbrun
	@mkdir -p build/amiga
	cp $(BUILDDIR)/clamiga build/amiga/clamiga
	cp $(BUILDDIR)/wbrun build/amiga/wbrun
	@rm -f build/amiga/clamiga-test.img build/amiga/boot.img build/amiga/exe-test build/amiga/exe-wb.log
	@echo "=== Launching FS-UAE (high-end JIT config) — auto-quits when tests finish ==="
	@# The suite flushes its log after every check and no check takes more
	@# than ~80 s on this config, so 5 min of silence is a hang -- the 10 min
	@# default (kept for the slower configs) only doubled what a wedge cost.
	STALL_TIMEOUT=$${STALL_TIMEOUT:-300} verify/realamiga/run-fs-uae.sh verify/realamiga/verify.fs-uae
	@$(MAKE) --no-print-directory -f Makefile.cross verify-amiga

# Run the GUI example programs (examples/amiga/gfx/ and reaction/) unattended
# in FS-UAE and photograph every window and custom screen into
# build/amiga/shots/*.png — see verify/realamiga/run-examples.sh.
examples-amiga: $(BUILDDIR)/clamiga
	verify/realamiga/run-examples.sh $(BUILDDIR)/clamiga

# Bare-boot heap image for deployment (specs/image-save-load.md, README
# "Heap images"): images are per-build, so the Amiga binary writes its own —
# unattended in FS-UAE through the boot-override hook of call-on-ustartup —
# and restarts from it to prove the result.  Lands beside the binary as
# $(BUILDDIR)/clamiga.img (FPU=1: build/cross-fpu/clamiga.img), which is
# where startup looks (PROGDIR:).  make-binary-release.sh runs the same
# script against the staged release layout, so the shipped images come from
# the shipped FASLs.
image-amiga: $(BUILDDIR)/clamiga
	verify/realamiga/make-image.sh $(BUILDDIR)

# The Clamacs editor's heap image beside the binary (BUILDDIR/clamacs.img),
# saved + verified in FS-UAE from the submodule's sources: the editor's
# files are staged under build/editor-lib/lib/clamacs/ the way the release
# ships them (verify/realamiga/make-editor-image.sh wants a lib/clamacs/).
editor-image-amiga: $(BUILDDIR)/clamiga
	rm -rf build/editor-lib && mkdir -p build/editor-lib/lib/clamacs
	cp clamacs/lisp/*.lisp clamacs/scripts/save-editor-image.lisp clamacs/scripts/verify-editor-image.lisp build/editor-lib/lib/clamacs/
	verify/realamiga/make-editor-image.sh $(BUILDDIR) build/editor-lib

test-amiga-lowend: $(BUILDDIR)/clamiga $(BUILDDIR)/wbrun
	@if [ "$(FPU)" = "1" ]; then \
		echo "ERROR: test-amiga-lowend runs an FPU-less 68020 config — the FPU=1 binary cannot run there."; \
		exit 1; \
	fi
	@mkdir -p build/amiga
	cp $(BUILDDIR)/clamiga build/amiga/clamiga
	cp $(BUILDDIR)/wbrun build/amiga/wbrun
	@rm -f build/amiga/clamiga-test.img build/amiga/boot.img build/amiga/exe-test build/amiga/exe-wb.log
	@echo "=== Launching FS-UAE (lower-end 68020 baseline) — auto-quits when tests finish ==="
	verify/realamiga/run-fs-uae.sh verify/realamiga/verify-lowend.fs-uae
	@$(MAKE) --no-print-directory -f Makefile.cross verify-amiga

verify-amiga:
	@if [ ! -f build/amiga/test-results.log ]; then \
		echo "No test results found. Run FS-UAE first."; \
		exit 1; \
	fi
	@echo "=== Amiga Test Results ==="
	@cat build/amiga/test-results.log
	@if ! grep -q "ALL TESTS PASSED" build/amiga/test-results.log; then \
		echo "=== Amiga verification FAILED (tests) ==="; \
		exit 1; \
	fi
	@# The suite runs TWICE: once from a fresh boot, once from a restored
	@# heap image (the restored-boot gate in call-on-ustartup).  Both runs
	@# must pass, and neither may report failures.
	@if [ "$$(grep -c 'ALL TESTS PASSED' build/amiga/test-results.log)" -lt 2 ]; then \
		echo "=== Amiga verification FAILED (restored-boot suite did not pass) ==="; \
		exit 1; \
	fi
	@if grep -q "SOME TESTS FAILED" build/amiga/test-results.log; then \
		echo "=== Amiga verification FAILED (a suite run reported failures) ==="; \
		exit 1; \
	fi
	@# Heap-image save/restore leg (tests/amiga/image-save.lisp +
	@# image-verify.lisp): state saved by one clamiga process must verify
	@# in a second one restored from the image.
	@if ! grep -q "IMAGE-VERIFY-PASSED" build/amiga/test-results.log; then \
		echo "=== Amiga verification FAILED (heap-image save/restore) ==="; \
		exit 1; \
	fi
	@if ! grep -q "IMAGE-RESTORE-HOOK-RAN" build/amiga/test-results.log; then \
		echo "=== Amiga verification FAILED (EXT:*RESTORE-HOOKS* did not run) ==="; \
		exit 1; \
	fi
	@# Failed-start leg (tests/amiga/image-trunc.lisp): an arena that cannot
	@# be allocated and a truncated image both fail with their message and
	@# hand their memory back (AmigaOS does not reclaim a process's memory; a
	@# failed Clamacs start used to lose 2.5 MB).  Every launch shows a
	@# residue of a few hundred bytes at the report point, a normal exit too,
	@# so the bar is "under 4 KB", not zero.
	@if ! grep -q "Failed to allocate 1048576000-byte heap" build/amiga/test-results.log || \
	    ! grep -q "is truncated" build/amiga/test-results.log || \
	    ! awk '/is truncated|Failed to allocate 1048576000/ { want = 1; next } \
	           want && /^\[mem\] (exit|heap allocation failed):/ { \
	               want = 0; n++; \
	               if ($$0 ~ /fully returned/) ok++; \
	               else if (match($$0, /: [0-9]+ bytes NOT/) && substr($$0, RSTART + 2, RLENGTH - 8) + 0 < 4096) ok++ } \
	           END { exit !(n == 2 && ok == 2) }' build/amiga/test-results.log; then \
		echo "=== Amiga verification FAILED (a failed image start did not hand its memory back) ==="; \
		sed -n '/=== failed image starts ===/,/=== restored-boot suite ===/p' build/amiga/test-results.log; \
		exit 1; \
	fi
	@# Main-stack leg (tests/amiga/small-stack-check.lisp): started with
	@# `stack 8000`, the runtime swaps to its own 128K stack (platform_run_main).
	@if ! grep -q "SMALL-STACK-PASSED" build/amiga/test-results.log; then \
		echo "=== Amiga verification FAILED (small-stack start: the main stack swap) ==="; \
		exit 1; \
	fi
	@# Workbench-start leg (tests/amiga/wb-check.lisp via wbrun): tool types
	@# as options, the project as EXT:*COMMAND-LINE-ARGS*, the WINDOW console.
	@if ! grep -q "WORKBENCH-START-PASSED" build/amiga/test-results.log; then \
		echo "=== Amiga verification FAILED (Workbench start) ==="; \
		exit 1; \
	fi
	@# Delivered-executable leg (tests/amiga/exe-save.lisp): the runtime with
	@# the image appended starts alone, owns its command line, exits with the
	@# program's status -- from the Shell and from an icon.
	@if ! grep -q "EXECUTABLE-PASSED" build/amiga/test-results.log || \
	    ! grep -q "^exe rc=5" build/amiga/test-results.log; then \
		echo "=== Amiga verification FAILED (delivered executable) ==="; \
		exit 1; \
	fi
	@if ! grep -q "EXECUTABLE-WB-PASSED" build/amiga/test-results.log; then \
		echo "=== Amiga verification FAILED (delivered executable, Workbench start) ==="; \
		exit 1; \
	fi
	@# The driver (call-on-ustartup) writes "=== run end ===" only after
	@# clamiga returns from main.  Its absence means clamiga hung at exit
	@# (e.g. the socket-reactor shutdown deadlock) and FS-UAE was stall-killed
	@# by the watchdog — the suite still "passed" but the binary never exited
	@# cleanly.  Require the marker so that regression fails loudly + fast.
	@if ! grep -q "=== run end ===" build/amiga/test-results.log; then \
		echo "=== Amiga verification FAILED (clamiga did not exit cleanly — shutdown hang?) ==="; \
		exit 1; \
	fi
	@# run-tests.lisp registers an EXT:*EXIT-HOOKS* hook that can only run from
	@# main.c's shutdown funnel.  Its marker is the end-to-end proof that exit
	@# hooks fire on AmigaOS; absence means the hooks were skipped on the way
	@# out (the in-suite checks only cover the list API).
	@if ! grep -q "EXIT-HOOK-RAN" build/amiga/test-results.log; then \
		echo "=== Amiga verification FAILED (exit hooks did not run at shutdown) ==="; \
		exit 1; \
	fi
	@echo "=== Amiga verification PASSED ==="

clean:
	rm -rf build/cross build/cross-fpu build/cross-wide build/cross-fpu-wide
