/* load-current-file.ced -- CygnusEd ARexx macro for AmiLisp
 *
 * Saves the current buffer, loads it into the running amilisp, and reports
 * the compile diagnostics in the editor's status line (with the full text
 * in a requester when something went wrong).
 *
 * Install: copy to REXX: (S: on a stock system) and bind it to a key from
 * CygnusEd's ARexx menu.  Start the port on the amilisp side first:
 *
 *     (require "amiga/arexx")
 *     (amiga.arexx:start)
 *
 * Put those two lines in S:.amilisprc to have every session offer the port.
 */

OPTIONS RESULTS

/* FAILAT 21 is not optional.  ARexx aborts a macro when a command's return
 * code reaches the FAILAT threshold, and the default is 10 -- which is
 * exactly the code amilisp returns for `your file has errors'.  Without
 * this the macro would die at the moment it had something to report. */
OPTIONS FAILAT 21

PORT = 'CLAMIGA'
IF ~SHOW('P', PORT) THEN DO
    /* A second amilisp takes CLAMIGA.1, and so on. */
    DO i = 1 TO 9
        IF SHOW('P', PORT'.'i) THEN DO
            PORT = PORT'.'i
            LEAVE i
        END
    END
END
IF ~SHOW('P', PORT) THEN DO
    'STATUS 0'          /* CygnusEd: ask for the current file name */
    CALL Message('AmiLisp is not running, or its ARexx port is not started.')
    EXIT 10
END

/* --- save the buffer so amilisp loads what is on screen ------------- */

ADDRESS 'rexx_ced'
'STATUS 24'             /* full path of the current file */
FILENAME = RESULT
IF FILENAME = '' THEN DO
    CALL Message('Save this buffer to a file first.')
    EXIT 10
END
'SAVE'

/* --- load it ---------------------------------------------------------- */

ADDRESS VALUE PORT
'LOAD "' || FILENAME || '"'
RC_LOAD = RC

IF RC_LOAD = 0 THEN DO
    ADDRESS 'rexx_ced'
    'OKAY1 "Loaded OK."'
    EXIT 0
END

/* rc /= 0, so ARexx did not give us RESULT: ask for the text explicitly.
 * This is the protocol, not a amilisp quirk -- a result string may only
 * accompany a zero return code. */
ADDRESS VALUE PORT
'LASTRESULT'
DIAGS = RESULT

ADDRESS 'rexx_ced'
IF RC_LOAD >= 10 THEN
    'OKAY1 "Load failed:*n*n' || DIAGS || '"'
ELSE
    'OKAY1 "Loaded with warnings:*n*n' || DIAGS || '"'

EXIT RC_LOAD

Message:
    PARSE ARG text
    ADDRESS 'rexx_ced'
    'OKAY1 "' || text || '"'
    RETURN
